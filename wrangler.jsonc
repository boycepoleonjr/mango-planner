// Cloudflare Workers static assets: serves the Next.js static export in out/.
// Build first (`pnpm build`), then `pnpm exec wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mango-planner",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./out",
    "not_found_handling": "404-page",
  },
}
